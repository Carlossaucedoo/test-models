{
	"info": {
		"name": "User API",
		"description": "API del modelo User (Laravel). Ejecuta las peticiones en orden (Runner) para probar el flujo completo: crear, listar, login, actualizar username, email y contraseña, y eliminar.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://test-models.test/api" },
		{ "key": "email", "value": "" },
		{ "key": "password", "value": "password123" },
		{ "key": "new_email", "value": "" },
		{ "key": "new_password", "value": "nuevaclave123" }
	],
	"item": [
		{
			"name": "1. Create",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Email distinto en cada ejecución para evitar el error de email repetido",
							"pm.collectionVariables.set('email', `alumno${Date.now()}@example.com`);",
							"pm.collectionVariables.set('password', 'password123');"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 201', () => pm.response.to.have.status(201));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"alumno\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/users",
					"host": ["{{base_url}}"],
					"path": ["users"]
				}
			}
		},
		{
			"name": "2. Get",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/users?page=1",
					"host": ["{{base_url}}"],
					"path": ["users"],
					"query": [{ "key": "page", "value": "1" }]
				}
			}
		},
		{
			"name": "3. Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/login",
					"host": ["{{base_url}}"],
					"path": ["login"]
				}
			}
		},
		{
			"name": "4. Update username",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"username\": \"alumno_nuevo\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/users/username",
					"host": ["{{base_url}}"],
					"path": ["users", "username"]
				}
			}
		},
		{
			"name": "5. Update email",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.collectionVariables.set('new_email', `nuevo${Date.now()}@example.com`);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));",
							"// Si ha ido bien, las siguientes peticiones usan el email nuevo",
							"if (pm.response.code === 200) {",
							"    pm.collectionVariables.set('email', pm.collectionVariables.get('new_email'));",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"new_email\": \"{{new_email}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/users/email",
					"host": ["{{base_url}}"],
					"path": ["users", "email"]
				}
			}
		},
		{
			"name": "6. Update password",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));",
							"// Si ha ido bien, las siguientes peticiones usan la contraseña nueva",
							"if (pm.response.code === 200) {",
							"    pm.collectionVariables.set('password', pm.collectionVariables.get('new_password'));",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"new_password\": \"{{new_password}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/users/password",
					"host": ["{{base_url}}"],
					"path": ["users", "password"]
				}
			}
		},
		{
			"name": "7. Delete",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{base_url}}/users",
					"host": ["{{base_url}}"],
					"path": ["users"]
				}
			}
		}
	]
}
